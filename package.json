{
  "name": "bodhana",
  "version": "1.0.0",
  "description": "Bodhana Learning Portal — Math Tests & Word Puzzles",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:constructs": "node scripts/build-constructs.mjs",
    "prebuild": "npm run build:constructs",
    "predev": "npm run build:constructs",
    "pretest": "npm run build:constructs",
    "test": "vitest run",
    "test:constructs": "vitest run tests/constructs",
    "prebuild:hosted": "npm run build:constructs",
    "build:hosted": "node scripts/build-hosted.mjs",
    "package:pages": "node scripts/package-pages.mjs",
    "serve:portal": "node scripts/serve-portal.mjs",
    "pretest:portal": "npm run build:constructs",
    "test:portal": "playwright test --config playwright.portal.config.js",
    "audit:build": "node scripts/audit-build.mjs"
  },
  "devDependencies": {
    "@fontsource/andika": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.0.0-beta3",
    "js-yaml": "^5.4.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.6.0",
    "parse5": "^7.3.0",
    "pdfjs-dist": "^3.11.174",
    "playwright": "^1.63.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
