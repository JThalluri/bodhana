      "solutionSteps": ["2 − {frac:5/8} = {frac:16/8} − {frac:5/8} = {frac:11/8} = 1 {frac:3/8} m"] },
    { "questionId": "mlen-002", "type": "static", "difficulty": "medium", "grades": [6,7], "operations": ["division"],
      "question": "A carpenter cuts {frac:3/4} m of wood into 4 equal pieces. How long is each piece?",
      "answer": { "value": "3/16", "valueType": "fraction", "unit": "m" },
      "solutionSteps": ["{frac:3/4} ÷ 4 = {frac:3/4} × {frac:1/4} = {frac:3/16} m"] },
    { "questionId": "mlen-003", "type": "static", "difficulty": "medium", "grades": [7], "operations": ["addition"],
      "question": "A rope is {frac:2/3} m. Another is {frac:3/4} m. What is the total length?",
      "answer": { "value": "1 5/12", "valueType": "mixed", "alternatives": ["17/12"], "unit": "m" },
      "solutionSteps": ["{frac:2/3} + {frac:3/4} = {frac:8/12} + {frac:9/12} = {frac:17/12} = 1 {frac:5/12} m"] },
    { "questionId": "mlen-004", "type": "static", "difficulty": "hard", "grades": [7], "operations": ["addition"],
      "question": "Three pencils are {frac:1/2} m, {frac:1/3} m and {frac:1/4} m long. What is their total length?",
      "answer": { "value": "1 1/12", "valueType": "mixed", "alternatives": ["13/12"], "unit": "m" },
      "solutionSteps": ["{frac:1/2}+{frac:1/3}+{frac:1/4} = {frac:6/12}+{frac:4/12}+{frac:3/12} = {frac:13/12} = 1 {frac:1/12} m"] },
    { "questionId": "mlen-005", "type": "static", "difficulty": "medium", "grades": [7], "operations": ["subtraction"],
      "question": "Cloth is {frac:3 1/2} m. You use {frac:1 3/4} m. How much is left?",
      "answer": { "value": "1 3/4", "valueType": "mixed", "alternatives": ["7/4"], "unit": "m" },
      "solutionSteps": ["3 {frac:1/2} − 1 {frac:3/4} = {frac:7/2} − {frac:7/4} = {frac:14/4} − {frac:7/4} = {frac:7/4} = 1 {frac:3/4} m"] },
    { "questionId": "mlen-006", "type": "static", "difficulty": "medium", "grades": [7], "operations": ["division"],
      "question": "Each tile is {frac:1/4} m long. How many tiles fit in a 3 m row?",
      "answer": { "value": "12", "valueType": "whole", "unit": "tiles" },
      "solutionSteps": ["3 ÷ {frac:1/4} = 3 × 4 = 12 tiles"] },
    { "questionId": "mlen-007", "type": "static", "difficulty": "easy", "grades": [6], "operations": ["subtraction"],
      "question": "A ribbon is {frac:7/8} m. You cut off {frac:1/4} m. How much remains?",
      "answer": { "value": "5/8", "valueType": "fraction", "unit": "m" },
      "solutionSteps": ["{frac:7/8} − {frac:1/4} = {frac:7/8} − {frac:2/8} = {frac:5/8} m"] },
    { "questionId": "mlen-008", "type": "static", "difficulty": "medium", "grades": [7], "operations": ["addition"],
