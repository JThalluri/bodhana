    { "questionId": "mlen-010", "type": "static", "difficulty": "easy", "grades": [6], "operations": ["addition"],
      "question": "A stick is {frac:5/6} m. Another is {frac:2/3} m. What is their total?",
      "answer": { "value": "1 1/2", "valueType": "mixed", "alternatives": ["3/2"], "unit": "m" },
